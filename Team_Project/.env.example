# Copy this file to .env for local development. Do not commit .env.
# Every secret for this course project (database password, JWT secret, Google
# key) lives in the gitignored .env file.
COMPOSE_PROJECT_NAME=book-metaverse

# PostgreSQL
POSTGRES_DB=book_metaverse
POSTGRES_USER=book_app
POSTGRES_PASSWORD=local_dev_password_only
POSTGRES_PORT=5432

# Go API
API_PORT=8080
DATABASE_URL=postgres://book_app:local_dev_password_only@postgres:5432/book_metaverse?sslmode=disable
# Any non-empty random string. Used to sign session tokens.
JWT_SECRET=replace_with_a_long_random_value
# false for plain-HTTP local and EC2 demos; true only behind HTTPS.
COOKIE_SECURE=false

# Next.js frontend (used when the web container is added). The browser calls
# /api/... on the page's own origin; Next.js forwards those requests to the Go
# API, so there is no CORS and no API URL in the browser bundle.
WEB_PORT=3000
# Where Next.js forwards /api requests. Read when `next build` runs.
# npm run dev: http://localhost:8080. Compose: http://api:8080.
API_PROXY_TARGET=http://localhost:8080

# Google Books search (GET /api/external/books, POST /api/books/import).
# The key stays on the server. Without a key, Google allows only a small
# anonymous quota; create one in Google Cloud Console with only the Books API
# enabled.
GOOGLE_BOOKS_API_KEY=
# Google rejects some server requests whose location it cannot determine
# (403 unknownLocation, common on cloud hosts). Sending a country avoids it.
GOOGLE_BOOKS_COUNTRY=US

# Amazon RDS for PostgreSQL (required for ./scripts/dev.sh rds).
# RDS_HOST comes from `terraform output -raw db_address`. The database name,
# user, and password are in the Secrets Manager secret that Terraform creates:
#   aws secretsmanager get-secret-value --secret-id "$(terraform output -raw db_secret_arn)" --query SecretString --output text
# (Terraform defaults: database appdb, user appadmin.)
RDS_HOST=
RDS_PORT=5432
RDS_DB=appdb ## ## need to align with tf, confirm later
RDS_USER=appadmin
RDS_PASSWORD=
RDS_SSLMODE=require
