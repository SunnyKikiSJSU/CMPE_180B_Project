# Copy this file to .env for local development. Do not commit .env.
COMPOSE_PROJECT_NAME=book-metaverse

# PostgreSQL
POSTGRES_DB=book_metaverse
POSTGRES_USER=book_app
POSTGRES_PASSWORD=local_dev_password_only
POSTGRES_PORT=5432

# Go API (used when the API container is added)
API_PORT=8080
DATABASE_URL=postgres://book_app:local_dev_password_only@postgres:5432/book_metaverse?sslmode=disable
JWT_SECRET=replace_with_a_long_random_value_at_least_32_chars

# Next.js frontend (used when the web container is added)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Books search (GET /api/external/books, POST /api/books/import).
# The key stays on the server. Without a key, Google allows only a small
# anonymous quota; create one in Google Cloud Console with only the Books API
# enabled and restrict it to the API server.
GOOGLE_BOOKS_API_KEY=
# Google rejects some server requests whose location it cannot determine
# (403 unknownLocation, common on cloud hosts). Sending a country avoids it.
GOOGLE_BOOKS_COUNTRY=US

# Amazon RDS for PostgreSQL (required for ./scripts/dev.sh rds)
RDS_HOST=
RDS_PORT=5432
RDS_DB=book_metaverse
RDS_USER=
RDS_PASSWORD=
RDS_SSLMODE=require
